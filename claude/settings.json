{
  "awsCredentialExport": "\"/Users/jmcada/.toolbox/bin/claude\" default-credential-export",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "AWS_REGION": "us-west-2"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep",
      "LS",
      "Agent",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "TodoWrite",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "mcp__builder-mcp__*"
    ],
    "deny": []
  },
  "model": "opus",
  "availableModels": [
    "opus",
    "sonnet"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stash_command.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh needs_input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh done"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "nelson@nelson-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "aws-dev-toolkit@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": true
}
